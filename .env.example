# Environment Configuration (Twelve-Factor Factor III)
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# PostgreSQL Connection String
# Khi chay local: co the dung Docker hoac PostgreSQL local
# Khi len PaaS: lay connection string tu Render Managed Postgres / Supabase / Neon
DATABASE_URL="postgresql://postgres:password@localhost:5432/paas_db?schema=public"

# Co dung cho thi nghiem Rollback (true / false)
SIMULATE_FAILURE=false
